# https://clang.llvm.org/extra/clang-tidy/
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-trailing-return-type,
  -readability-identifier-length
WarningsAsErrors: '*'
# keep-open.c gets CLOSE_SIGNAL from app.Dockerfile; any valid signal will do
ExtraArgs: ['-DCLOSE_SIGNAL=SIGTERM']
